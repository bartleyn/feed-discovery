# Copy to .env and fill in values
# cp .env.example .env

POSTGRES_USER=feed
POSTGRES_PASSWORD=changeme
POSTGRES_DB=feed_discovery

DATABASE_URL=postgresql://feed:changeme@db:5432/feed_discovery

# Your Bluesky credentials (used to call feeds on your behalf)
ATPROTO_HANDLE=you.bsky.social
ATPROTO_PASSWORD=your-app-password

# Your Bluesky DID — resolved at login and cached; also used for arm bootstrap
DEFAULT_USER_DID=did:plc:...

# Feed generator public identity — must match Cloudflare tunnel hostname exactly
FEED_GENERATOR_HOSTNAME=feeds.barn.city
FEED_GENERATOR_DID=did:web:feeds.barn.city
